  "view_definitions": {
    "vwLecturerRatingSummary": "CREATE OR ALTER VIEW [dbo].[vwLecturerRatingSummary] AS\nSELECT l.LecturerID,l.FirstName,l.MiddleName,l.LastName,\n COUNT(CASE WHEN r.OverallScore IS NOT NULL THEN 1 END) AS TotalRatings,\n COALESCE(SUM(r.TotalAnswers),0) AS TotalAnswers,\n CAST(AVG(r.OverallScore) AS decimal(5,2)) AS AverageScore\nFROM dbo.Lecturers l LEFT JOIN dbo.vwRatingScores r ON r.LecturerID=l.LecturerID\nGROUP BY l.LecturerID,l.FirstName,l.MiddleName,l.LastName;\n\r\n",
    "vw_Ratings_Public": "CREATE   VIEW [dbo].[vw_Ratings_Public] AS\nSELECT r.RatingID,r.LecturerID,s.OverallScore,r.Comment,r.Likes,r.Dislikes,\n r.CreatedAt,r.CourseID,\n CASE WHEN t.TermID IS NULL THEN NULL ELSE CONCAT(t.AcademicYearStart,N'-',t.AcademicYearStart+1,N'/',t.TermNumber) END AS Semester,\n r.Status\nFROM dbo.Ratings r JOIN dbo.vwRatingScores s ON s.RatingID=r.RatingID\nLEFT JOIN dbo.AcademicTerms t ON t.TermID=r.TermID\nWHERE r.Status='Approved';",
    "vw_Ratings_Admin": "CREATE   VIEW [dbo].[vw_Ratings_Admin] AS\nSELECT r.RatingID,r.UserID,CONCAT(u.FirstName,N' ',u.LastName) AS StudentName,\n u.Email AS StudentEmail,sg.GroupCode AS StudentGroup,r.LecturerID,\n CONCAT_WS(N' ',l.FirstName,l.MiddleName,l.LastName) AS LecturerName,\n s.OverallScore,r.Comment,r.Status,r.Likes,r.Dislikes,r.CreatedAt,\n CASE WHEN t.TermID IS NULL THEN NULL ELSE CONCAT(t.AcademicYearStart,N'-',t.AcademicYearStart+1,N'/',t.TermNumber) END AS Semester,\n r.ApprovedByAdminID\nFROM dbo.Ratings r JOIN dbo.Users u ON u.UserID=r.UserID\nJOIN dbo.Lecturers l ON l.LecturerID=r.LecturerID\nJOIN dbo.vwRatingScores s ON s.RatingID=r.RatingID\nLEFT JOIN dbo.StudentGroups sg ON sg.GroupID=u.GroupID\nLEFT JOIN dbo.AcademicTerms t ON t.TermID=r.TermID;"
  },
