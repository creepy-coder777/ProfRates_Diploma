DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ProfRates_databaza
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
AUTH_PROVIDER=
AUDIT_PROVIDER=
RATING_EDIT_HOURS=24
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
SESSION_HOURS=8
RESET_MINUTES=30
VERIFICATION_MINUTES=60
MAIL_BACKEND=local
LOCAL_MAIL_DIR=var/mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Persistent student sign-in duration, only when Remember me is selected.
REMEMBER_SESSION_DAYS=14
